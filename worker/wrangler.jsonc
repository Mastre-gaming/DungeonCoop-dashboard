// Le Worker « en direct » : npm run deploy dans ce dossier (après npx wrangler login).
// Ses secrets ne sont jamais dans ce fichier : npx wrangler secret put GITHUB_TOKEN, WEBHOOK_SECRET, puis GITHUB_CLIENT_SECRET.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dungeoncoop-direct",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "SALLE", "class_name": "Salle" }]
  },
  // Le stockage SQLite est celui du plan gratuit.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Salle"] }],
  "vars": {
    // Les repos suivis : seuls leurs webhooks sont acceptés, et seuls leurs chemins sont lus avec le token.
    "DEPOTS": "Mastre-gaming/DungeonCoop,Mastre-gaming/DungeonCoop-dashboard",
    // La connexion GitHub du tableau de travail : le « Client ID » de l'OAuth App (public). Vide = pas de connexion.
    "GITHUB_CLIENT_ID": "Iv23liFD4VAEDRGpNxxv",
    // Les pages vers lesquelles un token peut repartir après la connexion. * = les aperçus de branche.
    "PAGES": "https://dungeoncoop-dashboard.mastredev.workers.dev,https://*-dungeoncoop-dashboard.mastredev.workers.dev,http://localhost:8000"
  },
  "observability": { "enabled": true }
}
